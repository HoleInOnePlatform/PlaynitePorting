<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net462</TargetFramework><LangVersion>12</LangVersion>
    <AssemblyName>Playnite.Tests</AssemblyName><Platforms>x86</Platforms><PlatformTarget>x86</PlatformTarget>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <PlayniteOutputDir Condition="'$(PlayniteOutputDir)' == ''">$(MSBuildThisFileDirectory)..\..\..\build\Release</PlayniteOutputDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Reference Include="Playnite"><HintPath>$(PlayniteOutputDir)\Playnite.dll</HintPath></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(PlayniteOutputDir)\Newtonsoft.Json.dll</HintPath></Reference>
    <Reference Include="System.Net.Http" /><Reference Include="System.Security" />
  </ItemGroup>
</Project>
