<Window x:Class="Playnite.Windows.DownloadStatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="다운로드" Width="540" Height="300"
        MinWidth="540" MinHeight="300"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" WindowStyle="None" Background="#101B2B">
    <Window.Resources>
        <Style x:Key="DownloadActionButton" TargetType="Button">
            <Setter Property="Background" Value="#253850" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#334A66" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="15,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="#101B2B" Padding="22">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="26" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="12" />
                <RowDefinition Height="22" />
                <RowDefinition Height="40" />
                <RowDefinition Height="36" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="다운로드" Foreground="White"
                       FontSize="16" FontWeight="Bold" />
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="GameName" Foreground="White" FontSize="13" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="78%" Foreground="#63A5FF"
                           FontSize="13" FontWeight="SemiBold" />
            </Grid>
            <Border Grid.Row="4" Background="#293C54" CornerRadius="6">
                <Grid ClipToBounds="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="78*" />
                        <ColumnDefinition Width="22*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#2362D3" CornerRadius="6" />
                </Grid>
            </Border>
            <Grid Grid.Row="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Width="120" Content="다운로드 취소"
                        Style="{StaticResource DownloadActionButton}" Click="CancelButton_Click" />
                <Button Grid.Column="2" Width="130" Content="저장공간 설정"
                        Style="{StaticResource DownloadActionButton}" />
            </Grid>
            <TextBlock Grid.Row="8" Text="사용 가능 124 GB" Foreground="#A4BEDF"
                       FontSize="12" />
        </Grid>
    </Border>
</Window>
