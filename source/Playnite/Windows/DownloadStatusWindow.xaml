<controls:WindowBase x:Class="Playnite.Windows.DownloadStatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Playnite.Controls"
        Title="다운로드" Width="540" Height="200"
        MinWidth="540" MinHeight="200"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" ShowMinimizeButton="False" ShowMaximizeButton="False"
        ResizeMode="NoResize" Background="#101B2B">
    <Border Background="#101B2B" Padding="22">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="26" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="다운로드" Foreground="White"
                       FontSize="16" FontWeight="Bold" />
            <Grid Grid.Row="2">
                <TextBlock x:Name="GameName" Foreground="White" FontSize="13" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
            <TextBlock x:Name="StatusText" Grid.Row="4" Text="다운로드 상태 확인 중"
                       Foreground="#63A5FF" FontSize="13" FontWeight="SemiBold" />
        </Grid>
    </Border>
</controls:WindowBase>
