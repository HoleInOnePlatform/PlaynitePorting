<controls:WindowBase x:Class="Playnite.Windows.WebViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Playnite.Windows"
        xmlns:cefSharp="clr-namespace:CefSharp.Wpf;assembly=CefSharp.Wpf"
        mc:Ignorable="d" Loaded="Window_Loaded"
        Title="" Height="450" Width="800"
        xmlns:controls="clr-namespace:Playnite.Controls"
        Style="{DynamicResource StandardWindowStyle}"
        WindowStartupLocation="CenterOwner"
        KeyUp="WindowBase_KeyUp">
    <controls:WindowBase.Resources>
        <ControlTemplate x:Key="GameWindowTemplate" TargetType="{x:Type controls:WindowBase}">
            <AdornerDecorator>
                <ContentPresenter Content="{TemplateBinding Content}" />
            </AdornerDecorator>
        </ControlTemplate>
    </controls:WindowBase.Resources>
    <DockPanel Name="PanelContent">
        <TextBox Name="AddressBar" Text="{Binding Address, ElementName=Browser}"
                 Background="{DynamicResource NormalBrushDark}"
                 DockPanel.Dock="Top" IsReadOnly="True" BorderThickness="0"/>
        <Grid DockPanel.Dock="Bottom">
            <cefSharp:ChromiumWebBrowser Name="Browser" />
            <!-- Transparent outside overlay content so game input reaches the browser. -->
            <Grid Name="PanelOverlay" Focusable="False" Panel.ZIndex="1" />
        </Grid>
    </DockPanel>
</controls:WindowBase>
