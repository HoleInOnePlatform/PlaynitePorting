<controls:WindowBase x:Class="Playnite.DesktopApp.Windows.GameDetailsWindow"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:controls="clr-namespace:Playnite.Controls;assembly=Playnite"
                     Width="650" Height="390" MinWidth="540" MinHeight="330"
                     WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
                     ShowMinimizeButton="False" ShowMaximizeButton="False"
                     Style="{DynamicResource StandardWindowStyle}">
    <Border Margin="18" Padding="18" Background="#101C2B" CornerRadius="6">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#1B2C40" BorderBrush="#2B4059"
                    BorderThickness="1" CornerRadius="5">
                <Image Stretch="UniformToFill" RenderOptions.BitmapScalingMode="Fant">
                    <Image.Source>
                        <PriorityBinding>
                            <Binding Path="CoverImageObjectCached" />
                            <Binding Path="DefaultCoverImageObjectCached" />
                        </PriorityBinding>
                    </Image.Source>
                </Image>
            </Border>
            <StackPanel Grid.Column="2" Margin="0,4,0,0">
                <TextBlock Text="{Binding DisplayName}" Foreground="White" FontSize="24"
                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding LibraryPlugin.Name}" Foreground="#79B4F2"
                           FontSize="12" Margin="0,4,0,18" />
                <Grid Height="48">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="PlayButton" Grid.Column="0" Content="{DynamicResource LOCPlayGame}"
                            Background="#1C5BD4" Foreground="White" FontWeight="SemiBold"
                            Click="PlayButton_Click" />
                    <Button x:Name="LocalInstallButton" Grid.Column="2" Content="{DynamicResource LOCLocalInstallGame}"
                            Background="#293E57" Foreground="White" FontWeight="SemiBold"
                            Click="LocalInstallButton_Click" />
                </Grid>
                <TextBlock Text="{DynamicResource LOCLastPlayed}" Foreground="#79B4F2"
                           FontSize="12" Margin="0,28,0,3" />
                <TextBlock Text="{Binding LastActivity, Converter={StaticResource DateTimeToLastPlayedConverter}}"
                           Foreground="White" FontSize="13" />
                <TextBlock Text="{DynamicResource LOCTimePlayed}" Foreground="#79B4F2"
                           FontSize="12" Margin="0,20,0,3" />
                <TextBlock Text="{Binding Playtime, Converter={StaticResource PlayTimeToStringConverter}}"
                           Foreground="White" FontSize="13" />
            </StackPanel>
        </Grid>
    </Border>
</controls:WindowBase>
